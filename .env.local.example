# Copia este archivo como .env.local y pásalo a Compose con --env-file.
# La IP LAN y los nombres mDNS se pasan al helper del certificado, no se
# configuran en este archivo.
LOCAL_TLS=true
COOKIE_SECURE=true

# En modo TLS, HTTPS conserva el puerto habitual de Vite. Compose todavía debe
# reservar otro puerto para el mapeo HTTP, aunque nginx no lo escucha en este
# modo; 5174 sólo evita que ambos mapeos colisionen.
GATEWAY_HTTP_PORT=5174
GATEWAY_HTTPS_PORT=5173

# El backend usa por defecto un volumen Docker persistente para fotografías y
# acepta hasta 10 MiB por archivo. Para probar S3, cambia el proveedor y define
# bucket/región; entrega credenciales mediante la cadena estándar de AWS, nunca
# en un archivo versionado.
MEDIA_STORAGE_BACKEND=local
MEDIA_MAX_UPLOAD_BYTES=10485760
# MEDIA_S3_BUCKET=nombre-del-bucket
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_PREFIX=foodie
# MEDIA_PRESIGNED_URL_EXPIRATION_SECONDS=300
