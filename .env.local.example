# Copia este archivo como .env.local para que el gateway nginx termine TLS.
# El certificado debe incluir la IP LAN o el nombre mDNS que abrirás.
LOCAL_TLS=true
COOKIE_SECURE=true

# En el modo TLS, HTTPS conserva el puerto habitual de Vite. El mapeo HTTP se
# desplaza para que Compose no intente publicar dos servicios en el mismo puerto.
GATEWAY_HTTP_PORT=5174
GATEWAY_HTTPS_PORT=5173
