# Copia este archivo como .env.local y pásalo a Compose con --env-file.
# La IP LAN y los nombres mDNS se pasan al helper del certificado, no se
# configuran en este archivo.
LOCAL_TLS=true
COOKIE_SECURE=true

# En modo TLS, HTTPS conserva el puerto habitual de Vite. Compose todavía debe
# reservar otro puerto para el mapeo HTTP, aunque nginx no lo escucha en este
# modo; 5174 sólo evita que ambos mapeos colisionen.
GATEWAY_HTTP_PORT=5174
GATEWAY_HTTPS_PORT=5173
